# Public origins
BETTER_AUTH_URL=https://getrepot.com
REPOT_MCP_RESOURCE=https://mcp.getrepot.com/mcp

# Durable PostgreSQL (Neon/Vercel Postgres compatible)
DATABASE_URL=

# Better Auth signing/encryption secret (32+ high-entropy chars)
BETTER_AUTH_SECRET=

# Existing GitHub App OAuth credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-side AI
OPENAI_API_KEY=
# Production drafting model is pinned in code to gpt-6.1-sol (medium reasoning).

# 32 random bytes, base64 encoded; encrypts stored Repot review payloads
REPOT_DATA_KEY=

# Optional operational limits
REPOT_DAILY_DRAFT_LIMIT=20
REPOT_DAILY_PUBLISH_LIMIT=10
REPOT_REVIEW_TTL_MINUTES=60
