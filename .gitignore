# Repot repository ignore policy. Keeps dependencies, build output, local databases, secrets, and generated evidence out of version control.
node_modules/
dist/
.demo-dist/
.compiled/
*.tsbuildinfo
.env
.env.*
!.env.example
.graft-data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.repot-site/
.repot-evidence/
.next/
public/
