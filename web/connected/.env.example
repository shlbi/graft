# Copy to .env locally; NEVER commit populated secrets.
# Missing identity/secret/invite fields make startup fail closed.
GRAFT_ENV=development
GRAFT_PUBLIC_URL=http://127.0.0.1:4319
PORT=4319
GRAFT_LISTEN_HOST=127.0.0.1
GRAFT_DATABASE=./.graft-data/connected.sqlite
GRAFT_GITHUB_APP_ID=
GRAFT_GITHUB_CLIENT_ID=
GRAFT_GITHUB_CLIENT_SECRET=
GRAFT_WEBHOOK_SECRET=
GRAFT_DATA_KEY=
GRAFT_ALLOWED_USER_IDS=
GRAFT_ENABLE_PR_WRITES=false
GRAFT_USER_DAILY_DRAFTS=3
GRAFT_GLOBAL_DAILY_DRAFTS=20
# Optional. Leave BOTH empty to disable all paid drafting.
OPENAI_API_KEY=
GRAFT_AI_MODEL=
