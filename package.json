{
  "name": "graft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "typescript": "5.8.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "demo": "npm run build && node demo/verify.mjs",
    "demo:http": "npm run build && node demo/http-transplant.mjs",
    "ui": "npm run build && node ui/server.mjs",
    "web": "node web/server.mjs",
    "test:web": "node --test web/test/*.test.mjs",
    "connected": "node web/connected/server.mjs",
    "test:connected": "node --test --test-timeout=15000 web/connected/test/*.test.mjs"
  }
}
